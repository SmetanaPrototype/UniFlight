APP: FvKompasPlugin
VERSION: 5.0
project_version: BDB245C9-22AB-4BD8-9060-62D44BCC1D2D
geom_version: 7DAACB55-61E4-4D99-9B41-3BB57261C2AE
study_version: yes
general parameters:
  import tolerance: 1e-08
  reference temperature: 273
  reference pressure: 101000
  gravity_vector: { x: 9.81, y: 0, z: 0 }
  hydrostatics: no
substance:
  state: GAS
  density:
    type: ideal gas law
  molar_mass:
    type: constant
    value_c: 0.029
  viscosity:
    type: constant
    value_c: 2e-05
  thermal_conductivity:
    type: constant
    value_c: 0.022
  specific_heat:
    type: constant
    value_c: 1000
phase:
  motion: NAVIER_STOKES
  turbulence: NO_TURB
  heat_transfer: NO_ENTHALPY
  radiation: NO_RADIATION
moving bodies:
  -
    name: "Тело 1"
    id: 1
    patches_bc: [0, 0, 0, 0, 0]
boundary_conditions:
  -
    name: "Граничное условие"
    id: 0
    object_id: BEF622DB-D7D2-4D69-AD08-D524DCFCCD36
    type: WALL
    wall_func: yes
    wall_roughness: 0
    variables:
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_INLET"
    id: 1
    object_id: 6A198081-6989-4F56-8E65-B28E1ADCBE9D
    type: INLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelVectorPres
          vel_vec: { x: 34, y: 1.2, z: 0 }
          pressure: 0
    turb_level: LOW
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_OUTLET"
    id: 2
    object_id: 54414123-0A3F-4B47-B53A-BB16B2D40DA6
    type: FREEOUTLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: Pressure
          pressure: 0
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_NONREFLECT"
    id: 3
    object_id: 2AE61D3A-92BF-4C54-849F-4384E331C66A
    type: NONREFLECT
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelRiemann
          vel_inf: { x: 34, y: 1.2, z: 0 }
          pres_inf: 0
    color: { red: 0, green: 0, blue: 255 }
initial_conditions:
  velocity: { x: 34, y: 1.2, z: 0 }
  pressure: 0
  turb_level: LOW
  temperature: 0
initial_grid:
  num_cells: [10, 10, 10]
  do_adapt_to_solution: yes
  start_iter: 10
  duration: 2
  period: 10
  adapt_var: VAR_PRES
  do_adapt_to_grad: yes
  adapt_value: 0
  max_cell_count: 100000
  max_adapt_level: 2
  adaptation: 
    -
      adp_curv_add_layers: 1
      adp_curv_max_angle: 15
      adp_curv_upper_limit: 120
      adp_edge_add_layers: 1
      adp_edge_angle: 60
      bconds: [0]
      do_adapt_to_curv: no
      do_adapt_to_edge: no
      is_active: yes
      max_level: 2
      name: "Адаптация #1"
      num_layers: [3, 3]
      object_id: "C6A5F791-352E-4234-86EF-7E3954C91D9C"
solver_params:
  time_step_mode: CFL
  user_step: 0.001
  cfl: 30
  max_time_step: 0.1
  simulation_time: 5
  data_save_freq: 50
  log_depth: 1
  calc_limiters: 
    -
      type: "MIN"
      value: 1e-10
      variable: "VAR_DENS"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_VEL"
    -
      type: "MIN"
      value: -1e+20
      variable: "VAR_PRES"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_PRES"
geometry:
# for each patch in region VTK set BC index
  patches_bc: [3, 3, 3, 3, 3, 3]
objects:
  planes:
    -
      id: 1
      name: "Смещенная плоскость:1"
      normal: { x: 0, y: 0, z: 1 }
      object_id: "45F0A704-0AD0-4B54-9EEE-8764FCA6FBB1"
      point: { x: 0.0005, y: 0.0005, z: 0.01 }
  points:
layers:
  -
    name: "Слой #1"
    object: "PLANE_OBJECT"
    object_id: "024EE8C9-770B-4B91-B355-D3A8BA3419A0"
    plane_id: 1
    type: "SCALAR_LAYER"
    variable: "VAR_PRES"
result_chars:
  -
    GUID_chars: "EC144AEF-DC18-4E4F-B828-93BF215A5E92"
    GUID_stopper: "D09D4B85-CAAA-437A-8B77-6CFB9BE02427"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4]
    name: "Результат #1"
    object: "SURFACE"
    object_id: "6F3D9899-6F5B-4513-9F38-80A196A0DDC4"
    var: "F_SURFACE"
    vec_comp: "COMP_X"
  -
    GUID_chars: "03684A00-EC70-49DA-A350-E9755DB7AE0B"
    GUID_stopper: "1CC6BF12-4B33-4969-B4C2-DAE6ECB6AF97"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4]
    name: "Результат #2"
    object: "SURFACE"
    object_id: "173E0F3B-5E2E-4C31-884C-96735ED37C06"
    var: "F_SURFACE"
    vec_comp: "COMP_Y"
