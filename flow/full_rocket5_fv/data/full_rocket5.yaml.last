APP: FvKompasPlugin
VERSION: 5.0
project_version: 1D1C6E46-8F13-429B-A4FD-9A2C4CCB711F
geom_version: BED45817-A819-4B40-A4AF-A94B72C19DAC
study_version: yes
general parameters:
  import tolerance: 1e-08
  reference temperature: 273
  reference pressure: 101000
  gravity_vector: { x: 0, y: 0, z: 0 }
  hydrostatics: no
substance:
  state: GAS
  density:
    type: ideal gas law
  molar_mass:
    type: constant
    value_c: 0.029
  viscosity:
    type: constant
    value_c: 2e-05
  thermal_conductivity:
    type: constant
    value_c: 0.022
  specific_heat:
    type: constant
    value_c: 1000
phase:
  motion: NAVIER_STOKES
  turbulence: NO_TURB
  heat_transfer: NO_ENTHALPY
  radiation: NO_RADIATION
moving bodies:
  -
    name: "Тело 3"
    id: 1
    patches_bc: [0, 0, 0, 0, 0, 0, 0]
  -
    name: "Тело 2"
    id: 2
    patches_bc: [0, 0, 0]
boundary_conditions:
  -
    name: "Граничное условие"
    id: 0
    object_id: E0D2E75C-8E79-42F4-ADE2-23EC56270212
    type: WALL
    wall_func: yes
    wall_roughness: 0
    variables:
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_INLET"
    id: 1
    object_id: 081D39BA-DBF8-493B-8C96-FE0F40005304
    type: INLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelVectorPres
          vel_vec: { x: -103, y: 0, z: 0 }
          pressure: 0
    turb_level: LOW
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_OUTLET"
    id: 2
    object_id: AAF13B4F-D992-490C-A096-24F7DE59B636
    type: FREEOUTLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: Pressure
          pressure: 0
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_NONREFLECT"
    id: 3
    object_id: A1D45E41-D14B-44C5-87C3-869C53A6BB80
    type: NONREFLECT
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelRiemann
          vel_inf: { x: -103, y: 0, z: 0 }
          pres_inf: 0
    color: { red: 0, green: 0, blue: 255 }
initial_conditions:
  velocity: { x: -103, y: 0, z: 0 }
  pressure: 0
  turb_level: LOW
  temperature: 0
initial_grid:
  num_cells: [10, 10, 10]
  do_adapt_to_solution: yes
  start_iter: 10
  duration: 2
  period: 10
  adapt_var: VAR_PRES
  do_adapt_to_grad: yes
  adapt_value: 0
  max_cell_count: 100000
  max_adapt_level: 3
  adaptation: 
    -
      adp_curv_add_layers: 1
      adp_curv_max_angle: 15
      adp_curv_upper_limit: 120
      adp_edge_add_layers: 1
      adp_edge_angle: 60
      bconds: [0]
      do_adapt_to_curv: no
      do_adapt_to_edge: no
      is_active: yes
      max_level: 3
      name: "Адаптация #1"
      num_layers: [3, 3, 3]
      object_id: "A7128F2D-0B4B-4CA9-B558-39261E9B20EE"
solver_params:
  time_step_mode: CFL
  user_step: 0.001
  cfl: 10
  max_time_step: 0.1
  simulation_time: 8
  data_save_freq: 50
  log_depth: 1
  calc_limiters: 
    -
      type: "MIN"
      value: 1e-10
      variable: "VAR_DENS"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_VEL"
    -
      type: "MIN"
      value: -1e+20
      variable: "VAR_PRES"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_PRES"
geometry:
# for each patch in region VTK set BC index
  patches_bc: [3, 3, 3, 3, 3, 3]
objects:
  planes:
    -
      id: 1
      name: "Смещенная плоскость:1"
      normal: { x: 0, y: 0, z: 1 }
      object_id: "3EA04821-2B0F-4724-B600-CB1978E8005B"
      point: { x: 0.0005, y: 0.0005, z: 0.01 }
  points:
layers:
  -
    name: "Слой #1"
    object: "PLANE_OBJECT"
    object_id: "CAEC4C60-3FB7-4067-A510-09CEF9A8090A"
    plane_id: 1
    type: "SCALAR_LAYER"
    variable: "VAR_PRES"
result_chars:
  -
    GUID_chars: "31C3D695-004F-4D67-85B1-1D81E3DA29B6"
    GUID_stopper: "8A0A85F4-0D13-4D90-A750-A6D4FA6C9233"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 2, 0, 2, 1, 2, 2]
    name: "Результат #1"
    object: "SURFACE"
    object_id: "7454D5EA-C675-42AE-BC5F-2558CC8D22B7"
    var: "F_SURFACE"
    vec_comp: "COMP_X"
  -
    GUID_chars: "9A99F1BD-C768-4EC2-B4E6-4A2F1983AA58"
    GUID_stopper: "91D36A63-0A72-4943-B95D-EC4ABE84E355"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 2, 0, 2, 1, 2, 2]
    name: "Результат #2"
    object: "SURFACE"
    object_id: "D4A964C7-5854-492C-B583-6A4BB5F21A77"
    var: "F_SURFACE"
    vec_comp: "COMP_Y"
