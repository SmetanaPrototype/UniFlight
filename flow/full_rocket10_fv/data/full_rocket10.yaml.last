APP: FvKompasPlugin
VERSION: 5.0
project_version: EB0A7184-8FE3-4E08-9BBE-5E75E6A81D1D
geom_version: 4C94CE38-5058-4655-9180-60D7A993347E
study_version: yes
general parameters:
  import tolerance: 1e-08
  reference temperature: 273
  reference pressure: 101000
  gravity_vector: { x: 0, y: 0, z: 0 }
  hydrostatics: no
substance:
  state: GAS
  density:
    type: ideal gas law
  molar_mass:
    type: constant
    value_c: 0.029
  viscosity:
    type: constant
    value_c: 2e-05
  thermal_conductivity:
    type: constant
    value_c: 0.022
  specific_heat:
    type: constant
    value_c: 1000
phase:
  motion: NAVIER_STOKES
  turbulence: NO_TURB
  heat_transfer: NO_ENTHALPY
  radiation: NO_RADIATION
moving bodies:
  -
    name: "Тело 3"
    id: 1
    patches_bc: [0, 0, 0, 0, 0, 0, 0]
  -
    name: "Тело 1"
    id: 2
    patches_bc: [0, 0, 0]
boundary_conditions:
  -
    name: "Граничное условие"
    id: 0
    object_id: EBE63A8F-C78F-4386-9DCA-EB95A45E30F7
    type: WALL
    wall_func: yes
    wall_roughness: 0
    variables:
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_INLET"
    id: 1
    object_id: 8DCFBC83-A5E3-485A-BABC-DBC3F428214E
    type: INLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelVectorPres
          vel_vec: { x: -103, y: -5, z: 0 }
          pressure: 0
    turb_level: LOW
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_OUTLET"
    id: 2
    object_id: 025EA434-416C-425D-8B8D-ACD77BC90808
    type: FREEOUTLET
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: Pressure
          pressure: 0
    color: { red: 0, green: 0, blue: 255 }
  -
    name: "EXTENDED_NONREFLECT"
    id: 3
    object_id: BE3B187D-AF7E-4CD1-AB79-BB06264B30B1
    type: NONREFLECT
    variables:
      -
        var_type: VAR_VEL
        bvar:
          bvar_type: VelRiemann
          vel_inf: { x: -103, y: -5, z: 0 }
          pres_inf: 0
    color: { red: 0, green: 0, blue: 255 }
initial_conditions:
  velocity: { x: -103, y: -5, z: 0 }
  pressure: 0
  turb_level: LOW
  temperature: 0
initial_grid:
  num_cells: [10, 10, 10]
  do_adapt_to_solution: yes
  start_iter: 10
  duration: 2
  period: 10
  adapt_var: VAR_PRES
  do_adapt_to_grad: yes
  adapt_value: 0
  max_cell_count: 100000
  max_adapt_level: 3
  adaptation: 
    -
      adp_curv_add_layers: 1
      adp_curv_max_angle: 15
      adp_curv_upper_limit: 120
      adp_edge_add_layers: 1
      adp_edge_angle: 60
      bconds: [0]
      do_adapt_to_curv: no
      do_adapt_to_edge: no
      is_active: yes
      max_level: 3
      name: "Адаптация #1"
      num_layers: [3, 3, 3]
      object_id: "4587567B-5A92-4961-B34E-FFAC0917CCA4"
solver_params:
  time_step_mode: CFL
  user_step: 0.001
  cfl: 10
  max_time_step: 0.1
  simulation_time: 8
  data_save_freq: 50
  log_depth: 1
  calc_limiters: 
    -
      type: "MIN"
      value: 1e-10
      variable: "VAR_DENS"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_VEL"
    -
      type: "MIN"
      value: -1e+20
      variable: "VAR_PRES"
    -
      type: "MAX"
      value: 1e+20
      variable: "VAR_PRES"
geometry:
# for each patch in region VTK set BC index
  patches_bc: [3, 3, 3, 3, 3, 3]
objects:
  planes:
    -
      id: 1
      name: "Смещенная плоскость:1"
      normal: { x: 0, y: 0, z: 1 }
      object_id: "87764642-146D-493C-94C3-90240A183B8C"
      point: { x: 0.0005, y: 0.0005, z: 0.01 }
  points:
layers:
  -
    name: "Слой #1"
    object: "PLANE_OBJECT"
    object_id: "35D5BC16-A80B-49DF-A4AB-2D8A3E454FDC"
    plane_id: 1
    type: "SCALAR_LAYER"
    variable: "VAR_PRES"
result_chars:
  -
    GUID_chars: "FDC921CF-D956-43C5-A263-2398C846B817"
    GUID_stopper: "DD38F087-C249-464A-BA42-C0C55D944916"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 2, 0, 2, 1, 2, 2]
    name: "Результат #1"
    object: "SURFACE"
    object_id: "C2090E92-146B-4D2A-921B-CC2BA08AD093"
    var: "F_SURFACE"
    vec_comp: "COMP_X"
  -
    GUID_chars: "A3815EAC-4D0F-4355-ABB2-80CBDCC7B472"
    GUID_stopper: "2CEE3CE4-7BBA-4A75-A56D-136677E1A58C"
    faces: [1, 0, 1, 1, 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 2, 0, 2, 1, 2, 2]
    name: "Результат #2"
    object: "SURFACE"
    object_id: "498BAB6B-8810-498C-91D1-56B12092A042"
    var: "F_SURFACE"
    vec_comp: "COMP_Y"
